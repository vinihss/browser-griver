{
  "name": "griver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automatizador de browser local com extensão de navegador conectada, gravação de ações e assistente de IA",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "bootstrap": "node scripts/tasks.mjs bootstrap",
    "deps": "node scripts/tasks.mjs deps",
    "vendor": "node scripts/tasks.mjs vendor",
    "build": "node scripts/tasks.mjs build",
    "build:ext": "node packages/extension/build.mjs",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "typecheck:ext": "tsc --noEmit -p packages/extension/tsconfig.json",
    "dev:server": "node scripts/tasks.mjs serve",
    "dev:cli": "node scripts/tasks.mjs cli",
    "dev": "node scripts/tasks.mjs dev",
    "link-cli": "node scripts/tasks.mjs link-cli",
    "package": "node scripts/tasks.mjs package",
    "clean": "node scripts/tasks.mjs clean",
    "test": "node scripts/tasks.mjs test",
    "test:e2e:all": "node scripts/tasks.mjs e2e",
    "test:e2e:browser": "node packages/extension/test/manual-e2e.mjs",
    "test:e2e:painel": "node packages/extension/test/panel-save.e2e.mjs",
    "test:e2e:verifica": "node packages/extension/test/verifica-painel.e2e.mjs",
    "test:e2e:overlay": "node packages/extension/test/overlay.e2e.mjs",
    "test:e2e:nova": "node packages/extension/test/nova-receita.e2e.mjs",
    "test:e2e:cli": "node packages/extension/test/record-cli.e2e.mjs",
    "test:e2e:headless": "GRIVER_HEADLESS=1 node packages/extension/test/e2e-all.mjs",
    "test:e2e:headed": "GRIVER_HEADLESS=0 node packages/extension/test/e2e-all.mjs",
    "test:e2e:injecao": "node packages/extension/test/inject-host.e2e.mjs",
    "test:e2e:navegar": "node packages/extension/test/navegar-host.e2e.mjs",
    "test:e2e:preenchimento": "node packages/extension/test/navegar-fill.e2e.mjs",
    "test:e2e:erro": "node packages/extension/test/erro-gravacao.e2e.mjs",
    "test:e2e:chat": "node packages/server/test/chat.e2e.mjs",
    "test:e2e:uso": "node packages/extension/test/uso-real.e2e.mjs",
    "opencode": "opencode"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}

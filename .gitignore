node_modules/
dist/
*.tsbuildinfo
# a pasta de dados é do servidor (banco, token, artefatos); o `.gitkeep`
# mantém a pasta na árvore — o padrão `data/` inteiro não deixa o
# git descer na pasta, e aí a exceção não valeria
data/*
!data/.gitkeep
packages/extension/dist/
packages/extension/src/manifest.json.bak
.DS_Store
.env
.env.*
*.log

# o zip da extensão é artefato de build: `pnpm package` o gera a partir do
# `dist` da extensão, e versioná-lo só traz ruído binário para cada build
griver-extension.zip

{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "griver": {
      "description": "Assistente de automação de browser do Griver: edita receitas e ajuda a montar scripts",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "griver_page_click", "resource": "*", "effect": "ask" },
        { "action": "griver_page_fill", "resource": "*", "effect": "ask" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "griver": {
        "type": "local",
        "cwd": "packages/server",
        "command": ["node", "dist/mcp/main.js"],
        "environment": {
          "GRIVER_SERVER_URL": "http://127.0.0.1:7331"
        }
      }
    }
  }
}
